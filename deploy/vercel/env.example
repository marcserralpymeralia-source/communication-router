# KIBAK Vercel Pro pilot. Configure these in the Vercel project settings,
# never in Git or a local shell history.
APP_ENV=staging
APP_SLUG=kibak
DEPLOYMENT_MODE=vercel_pilot
PILOT_FREE_MODE=false
RUN_WORKERS_IN_WEB=false
APP_URL=https://kibak-pilot.vercel.app
RELEASE_SHA=<approved-release-sha>

SECRET_KEY=<secret-manager-value>
AUTH_SECRET=<secret-manager-value>
ENCRYPTION_KEY=<fernet-secret-manager-value>
CRON_SECRET=<optional-secret-manager-value>
DEBUG=false
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
SESSION_MAX_AGE=604800
ALLOWED_HOSTS=kibak-pilot.vercel.app
CORS_ALLOWED_ORIGINS=https://kibak-pilot.vercel.app
AUTH_THROTTLING_ENABLED=true

# Use pooled Neon URLs for requests. Run migrations with direct/session URLs
# outside the Function runtime.
TENANT_DB_MODE=external
MASTER_DATABASE_URL=<neon-pooled-master-url-with-sslmode=require>
TENANT_DATABASE_URL=<neon-pooled-tenant-url-with-sslmode=require>
DATABASE_URL=<neon-pooled-tenant-url-with-sslmode=require>

STORAGE_BACKEND=s3
S3_ENDPOINT_URL=<s3-compatible-endpoint>
S3_BUCKET=<private-kibak-pilot-bucket>
S3_REGION=auto
S3_ACCESS_KEY_ID=<secret-manager-value>
S3_SECRET_ACCESS_KEY=<secret-manager-value>
S3_PREFIX=kibak

# Configure these later when Google OAuth is approved for the public URL.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://kibak-pilot.vercel.app/settings/mailboxes/oauth/google/callback

# Keep provider credentials tenant-scoped in KIBAK's encrypted settings.
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
SMTP=false
IMAP_SYNC_ENABLED=false
EMAIL_AUTO_SYNC_ENABLED=false
TEMP_STORAGE_DIR=/tmp/kibak
LOG_FORMAT=json
LOG_LEVEL=info
