APP_ENV=staging
APP_SLUG=kibak
RELEASE_SHA=<git-sha>
RUN_WORKERS_IN_WEB=false
AUTH_THROTTLING_ENABLED=true
DEBUG=false
ENABLE_DEMO_BOOTSTRAP=false
SECRET_KEY=<secret-manager-value>
AUTH_SECRET=<secret-manager-value>
ENCRYPTION_KEY=<fernet-key-from-secret-manager>
TENANT_DB_MODE=external
MASTER_DATABASE_URL=<neon-master-url-with-sslmode=require>
TENANT_DATABASE_URL=<neon-first-tenant-url-with-sslmode=require>
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=<s3-compatible-endpoint>
S3_BUCKET=<private-kibak-bucket>
S3_REGION=auto
S3_ACCESS_KEY_ID=<secret-manager-value>
S3_SECRET_ACCESS_KEY=<secret-manager-value>
