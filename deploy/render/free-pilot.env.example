APP_ENV=staging
APP_SLUG=kibak
DEPLOYMENT_MODE=free_pilot
PILOT_FREE_MODE=true
APP_URL=https://<render-service>.onrender.com
RELEASE_SHA=<git-sha>
RUN_WORKERS_IN_WEB=true
AUTH_THROTTLING_ENABLED=true
TRUSTED_PROXY_IPS=<trusted-proxy-cidrs>
DEBUG=false
ENABLE_DEMO_BOOTSTRAP=false
SECRET_KEY=<secret-manager-value>
AUTH_SECRET=<secret-manager-value>
ENCRYPTION_KEY=<fernet-key-from-secret-manager>
TENANT_DB_MODE=external
MASTER_DATABASE_URL=<neon-pooled-master-url-with-sslmode=require>
TENANT_DATABASE_URL=<neon-pooled-tenant-url-with-sslmode=require>
ALLOWED_HOSTS=<render-service>.onrender.com
CORS_ALLOWED_ORIGINS=https://<render-service>.onrender.com
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=<r2-s3-endpoint>
S3_BUCKET=<private-kibak-r2-bucket>
S3_REGION=auto
S3_ACCESS_KEY_ID=<secret-manager-value>
S3_SECRET_ACCESS_KEY=<secret-manager-value>
GOOGLE_OAUTH_REDIRECT_URI=https://<render-service>.onrender.com/settings/mailboxes/oauth/google/callback
GOOGLE_OAUTH_SCOPES=https://mail.google.com/ https://www.googleapis.com/auth/userinfo.email
OPENAI_BASE_URL=https://api.openai.com/v1
