# KIBAK local environment. Copy this file to backend/.env.
# Never commit backend/.env or put production secrets here.

APP_ENV=development
APP_NAME=KIBAK
APP_SLUG=kibak
APP_URL=http://127.0.0.1:8000

SESSION_COOKIE=kibak_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_MAX_AGE=604800

# Generate locally with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
AUTH_SECRET=
CRON_SECRET=

# Generate locally with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

TENANT_DB_MODE=external
DATABASE_URL=postgresql+psycopg://kibak_local:kibak_local_dev_password@localhost:5433/kibak_tenant_test
TENANT_DATABASE_URL=postgresql+psycopg://kibak_local:kibak_local_dev_password@localhost:5433/kibak_tenant_test
MASTER_DATABASE_URL=postgresql+psycopg://kibak_local:kibak_local_dev_password@localhost:5433/kibak_master

# Routing reads the tenant LLMSettings record. These variables remain provider compatibility fallbacks.
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=60

JOB_POLL_INTERVAL_SECONDS=10
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_SECONDS=15
JOB_RETRY_MAX_SECONDS=300
JOB_STALE_AFTER_SECONDS=900
LOG_FORMAT=json
LOG_LEVEL=info
PERFORMANCE_PROFILING_ENABLED=false

# Keep bootstrap disabled until the KIBAK schema and seed flow are ready.
ENABLE_DEMO_BOOTSTRAP=false
DEBUG=false

DEFAULT_COMPANY_NAME=KIBAK Test
DEFAULT_ADMIN_EMAIL=admin@kibak.local
DEFAULT_ADMIN_PASSWORD=

BRANDING_APP_NAME=KIBAK
BRANDING_PRIMARY_CLAIM=Comunicaciones y routing inteligente
BRANDING_SECONDARY_CLAIM=
BRANDING_LOGO_URL=
BRANDING_DARK_LOGO_URL=
BRANDING_FAVICON_URL=
EMAIL_SIGNATURE_TEXT=Equipo KIBAK

# Local files are stored under backend/storage when this is relative to backend/.
TEMP_STORAGE_DIR=./storage
